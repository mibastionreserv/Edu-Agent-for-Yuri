# Copy to .env to override local defaults. .env is git-ignored and must never
# contain production secrets that get committed.

# Database (local dev credentials; change for any real deployment)
POSTGRES_USER=scrum
POSTGRES_PASSWORD=scrum_local_dev
POSTGRES_DB=scrumstage

# Auth signing secret. REQUIRED in production; set to a long random value.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=please-override-with-a-long-random-value

# Public web port
WEB_PORT=8080

# --- Optional: intelligent answers via an OpenAI-compatible LLM ---
# Leave BLANK to use the built-in grounded composer (no key required).
# When both are set, on-topic answers are generated by the LLM, constrained to
# the module's knowledge; off-topic deflection stays deterministic.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
